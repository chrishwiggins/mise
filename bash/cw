#!/bin/bash
# cw - manage chrishwiggins.com
#
# Usage:
#   cw 301 <slug> <url>       permanent redirect chrishwiggins.com/<slug> -> <url>
#   cw 302 <slug> <url>       temporary redirect
#   cw rm <slug> [...]        remove redirect(s)
#   cw ls                     list redirects
#   cw open <slug>            open URL in browser
#
# Examples:
#   cw 301 b http://ex.com   -> 301 chrishwiggins.com/b -> http://ex.com
#   cw rm a b                 remove redirects a and b
#   cw ls                     show what's live
#
# Backend: Cloudflare Single Redirects (dynamic redirect ruleset) on the
# chrishwiggins.com zone. The former RackNerd VPS backend
# (root@23.95.164.201) was cancelled 2026-05-26; its IP now belongs to
# someone else. Do NOT re-accept SSH host keys for that address. If an
# ssh/scp to it prompts about a changed host key, the answer is no.
#
# cw pub is disabled: file publishing needs a storage backend (R2 or
# GitHub Pages) that has not been set up since the VPS was terminated.
# Files previously published under /var/www/html/files/ are gone, and
# https://chrishwiggins.com/<slug> returns 521 for them because
# Cloudflare still cannot reach the dead origin.
#
# The apex 301s to https://www.columbia.edu/~chw2 via a separate
# Cloudflare rule. Single Redirects run before Page Rules in
# Cloudflare's traffic sequence, so per-slug rules created here win.

set -euo pipefail

ZONE="c82c2e46950311ea6b0374e4fa3eb2c0"   # chrishwiggins.com
TOKEN_FILE="$HOME/.config/cloudflare/token"
API="https://api.cloudflare.com/client/v4"
EP="$API/zones/$ZONE/rulesets/phases/http_request_dynamic_redirect/entrypoint"
DOMAIN="https://chrishwiggins.com"

usage() {
    sed -nE '2,/^$/s/^# ?//p' "$0"
    exit 0
}

cf() {
    curl -sS -m 30 -H "Authorization: Bearer $(cat "$TOKEN_FILE")" \
         -H "Content-Type: application/json" "$@"
}

check_slug() {
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Error: bad slug '$1' (use letters, digits, . _ -)"; exit 1; }
}

get_rules() {
    # existing redirect rules as a JSON array; [] if no ruleset exists yet
    cf "$EP" | jq '(.result.rules // []) | map({expression, description, action, action_parameters})'
}

put_rules() {
    # $1 = JSON array of rules; replaces the entrypoint ruleset wholesale
    local RESP
    RESP=$(jq -n --argjson rules "$1" '{rules: $rules}' | cf -X PUT --data-binary @- "$EP")
    if ! echo "$RESP" | jq -e '.success' >/dev/null 2>&1; then
        # no entrypoint ruleset yet: create it
        RESP=$(jq -n --argjson rules "$1" \
            '{name: "default", kind: "zone", phase: "http_request_dynamic_redirect", rules: $rules}' \
            | cf -X POST --data-binary @- "$API/zones/$ZONE/rulesets")
        if ! echo "$RESP" | jq -e '.success' >/dev/null 2>&1; then
            echo "Error: Cloudflare API:" >&2
            echo "$RESP" | jq '.errors' >&2 2>/dev/null || echo "$RESP" >&2
            if echo "$RESP" | jq -e '.errors[]? | select(.code == 10000)' >/dev/null 2>&1; then
                echo "" >&2
                echo "The token at ~/.config/cloudflare/token can read but not edit redirects" >&2
                echo "(it is cf-bill's Read All Resources token). Fix once, keeping the same secret:" >&2
                echo "  1. https://dash.cloudflare.com/profile/api-tokens" >&2
                echo "  2. Edit that token (created 2026-03-06, Read All Resources template)" >&2
                echo "  3. Add permission: Zone / Dynamic URL Redirects / Edit, all zones" >&2
                echo "  4. Save (the token string does not change), then rerun this command" >&2
            fi
            exit 1
        fi
    fi
}

do_redirect() {
    local CODE="$1" SLUG="$2" URL="$3"
    check_slug "$SLUG"
    local EXPR="(http.request.uri.path eq \"/${SLUG}\")"
    local RULES NEW
    RULES=$(get_rules)
    NEW=$(jq -n --arg expr "$EXPR" --arg desc "cw: $SLUG" --arg url "$URL" --argjson code "$CODE" \
        '{expression: $expr, description: $desc, action: "redirect",
          action_parameters: {from_value: {target_url: {value: $url}, status_code: $code, preserve_query_string: false}}}')
    put_rules "$(jq -n --argjson r "$RULES" --argjson n "$NEW" \
        '[$r[] | select(.expression != $n.expression)] + [$n]')"
    echo "$DOMAIN/$SLUG -> $URL ($CODE)"
}

case "${1:-}" in
    pub|pbu|add|push)
        echo "Error: cw pub is disabled. The VPS backend (23.95.164.201) was cancelled 2026-05-26."
        echo "That IP now belongs to someone else; do not scp to it or accept its host key."
        echo "Redirects still work (cw 301/302); file hosting needs a new backend (R2 or GitHub Pages)."
        exit 1
        ;;
    301|302)
        CODE="$1"; shift
        [ $# -lt 2 ] && { echo "Usage: cw $CODE <slug> <url>"; exit 1; }
        do_redirect "$CODE" "$1" "$2"
        ;;
    rm|del|remove)
        shift
        [ $# -lt 1 ] && { echo "Usage: cw rm <slug> [...]"; exit 1; }
        RULES=$(get_rules)
        CHANGED=false
        for slug in "$@"; do
            check_slug "$slug"
            EXPR="(http.request.uri.path eq \"/${slug}\")"
            if echo "$RULES" | jq -e --arg e "$EXPR" 'any(.[]; .expression == $e)' >/dev/null; then
                RULES=$(echo "$RULES" | jq --arg e "$EXPR" '[.[] | select(.expression != $e)]')
                echo "Removed redirect: $DOMAIN/$slug"
                CHANGED=true
            else
                echo "Not found: $slug"
            fi
        done
        $CHANGED && put_rules "$RULES"
        ;;
    ls|list)
        # slug-style rules (the ones cw creates) print as $DOMAIN/<slug>;
        # anything else (wildcard expressions, rules made in the dashboard)
        # prints its raw expression so ls never silently hides a rule.
        get_rules | jq -r --arg d "$DOMAIN" '
            .[]
            | (.action_parameters.from_value // {}) as $f
            | ((.expression | capture("eq \"/(?<p>[^\"]+)\"").p) // null) as $slug
            | if $slug then "  ->   \($d)/\($slug)  \($f.status_code) \($f.target_url.value // "?")"
              else "  ->   [\(.description // "no description")]  \($f.status_code // "?") \($f.target_url.value // "?")\n         expr: \(.expression)"
              end'
        echo "(apex: $DOMAIN/ -> https://www.columbia.edu/~chw2, 301, via separate Cloudflare rule)"
        ;;
    open)
        [ $# -lt 2 ] && { open "$DOMAIN"; exit 0; }
        open "$DOMAIN/$2"
        ;;
    status|st)
        cf "$API/zones/$ZONE" | jq -r '"zone: \(.result.name) (\(.result.status))"'
        echo "redirects: $(get_rules | jq 'length')"
        ;;
    -h|--help|help|"?"|"")
        usage
        ;;
    *)
        echo "cw: unknown command '$1'"
        echo "Try: cw help"
        exit 1
        ;;
esac
