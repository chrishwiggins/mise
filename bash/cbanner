#!/bin/bash
# cbanner - put a big message on the iTerm2 pane running this Claude session
#
# Usage: cbanner <text>                 - badge: big translucent text, upper right
#        cbanner --bg <text> [color]    - background image: huge text, any color
#        cbanner --auto                 - badge "<roster name>\npid<PID> <tty>" (SessionStart hook)
#        cbanner clear                  - remove badge and background image
#        cbanner -t <tty> ...           - target a pane by tty (012, ttys012, /dev/ttys012)
#
# \n in the text starts a new line. The target defaults to the tty of the nearest
# ancestor process whose executable is `claude`, the same walk /dedup uses: the
# Bash tool's shell and a hook's shell have no tty of their own. Outside Claude it
# falls back to this shell's tty.
#
# Both escapes are pane state, so a Claude TUI repainting does not erase them
# (badge verified 2026-09-29 in /dedup). Badge color is an iTerm2 profile setting;
# no escape changes it, which is why --bg exists. iTerm2 asks the user to confirm
# each background image file (iTerm2 escape-code docs, "Background Image").

TTY=""
CLAUDE_PID=""

find_claude() {
  local p=$$ x
  while [[ -n "$p" && "$p" != "1" ]]; do
    x=$(/bin/ps -p "$p" -o comm= 2>/dev/null)
    case "$x" in
      *claude|*/claude/versions/*)
        CLAUDE_PID=$p
        TTY=$(/bin/ps -p "$p" -o tty= 2>/dev/null | /usr/bin/tr -d ' ')
        return 0 ;;
    esac
    p=$(/bin/ps -p "$p" -o ppid= 2>/dev/null | /usr/bin/tr -d ' ')
  done
  return 1
}

norm_tty() {
  case "$1" in
    /dev/*) echo "${1#/dev/}" ;;
    ttys*) echo "$1" ;;
    *) echo "ttys$1" ;;
  esac
}

if [[ "$1" == "-t" ]]; then
  TTY=$(norm_tty "$2"); shift 2
else
  find_claude || TTY=$(/bin/ps -p $$ -o tty= 2>/dev/null | /usr/bin/tr -d ' ')
fi

if [[ -z "$TTY" || "$TTY" == "??" ]]; then
  echo "cbanner: no terminal to write to (tty '$TTY')" >&2
  exit 1
fi
DEV="/dev/$TTY"
if [[ ! -w "$DEV" ]]; then
  echo "cbanner: cannot write to $DEV" >&2
  exit 1
fi

b64() { printf '%b' "$1" | /usr/bin/base64 | /usr/bin/tr -d '\n'; }
badge() { printf '\033]1337;SetBadgeFormat=%s\a' "$(b64 "$1")" > "$DEV"; }
bgimage() { printf '\033]1337;SetBackgroundImageFile=%s\a' "$(b64 "$1")" > "$DEV"; }

case "$1" in
  ""|-h|--help)
    /usr/bin/sed -n '2,9p' "$0" | /usr/bin/sed 's/^# \{0,1\}//'
    exit 0 ;;

  clear)
    badge ""
    bgimage ""
    echo "cbanner: cleared $TTY" ;;

  --auto)
    # Silent on success: SessionStart hook stdout lands in the model's context.
    [[ -z "$CLAUDE_PID" ]] && exit 0
    name=$(/usr/bin/plutil -extract name raw "$HOME/.claude/sessions/$CLAUDE_PID.json" 2>/dev/null)
    [[ -z "$name" ]] && name=$(basename "$PWD")
    badge "$name\\npid$CLAUDE_PID $TTY" ;;

  --bg)
    shift
    text="${1:?usage: cbanner --bg <text> [color]}"
    color="${2:-red}"
    dir="$HOME/.cache/cbanner"
    /bin/mkdir -p "$dir"
    png="$dir/$(printf '%s|%s' "$text" "$color" | /sbin/md5 -q).png"
    if [[ ! -s "$png" ]]; then
      # caption: fits the text to the canvas; ~35% opacity keeps the terminal readable.
      /opt/homebrew/bin/magick -size 2400x1500 -background none \
        -fill "$color" -font /System/Library/Fonts/Helvetica.ttc -gravity center \
        caption:"$(printf '%b' "$text")" -channel A -evaluate multiply 0.35 +channel \
        "$png" || { echo "cbanner: magick failed" >&2; exit 1; }
    fi
    bgimage "$png"
    echo "cbanner: background on $TTY ($png)" ;;

  *)
    badge "$*"
    echo "cbanner: badge on $TTY" ;;
esac
