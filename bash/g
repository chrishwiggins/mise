#!/usr/bin/env bash
# g: search the web from the shell. Google by default, DuckDuckGo with -d.
#
#   g foo bar            google: foo bar
#   g -d +foo bar+       duckduckgo: "foo bar"   (a + becomes a double quote)
#   g -n site:x.org foo  print the URL instead of opening it
#
# Replaces the tcsh gsearch; gsearch is now a stub that calls this.

usage() {
    echo "usage: g [-d] [-n] <search terms>" >&2
    echo "  -d  DuckDuckGo instead of Google" >&2
    echo "  -n  print the URL, do not open it" >&2
    echo "  a + in the terms becomes a double quote, so +foo bar+ is a phrase" >&2
    exit "${1:-1}"
}

engine=google
dry=0
while getopts ":dnh" opt; do
    case $opt in
        d) engine=ddg ;;
        n) dry=1 ;;
        h) usage 0 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[[ $# -eq 0 ]] && usage

query="$*"
query="${query//+/\"}"

# Percent-encode everything outside the unreserved set, byte by byte, so
# & ? # = and non-ASCII survive; spaces become +.
encoded=""
LC_ALL=C
for ((i = 0; i < ${#query}; i++)); do
    c="${query:i:1}"
    case $c in
        [a-zA-Z0-9.~_-]) encoded+="$c" ;;
        ' ') encoded+="+" ;;
        *) printf -v b '%d' "'$c"; printf -v b '%%%02X' $((b & 255)); encoded+="$b" ;;
    esac
done

case $engine in
    google) url="https://www.google.com/search?q=$encoded" ;;
    ddg)    url="https://duckduckgo.com/?q=$encoded" ;;
esac

echo "$url"
[[ $dry -eq 1 ]] || /usr/bin/open "$url"
