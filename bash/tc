Design:
  tc --discuss                    # color assignment principles and audit doc
EOF
    ;;

  *)
    # Resolve any color name: builtins, then ~/.tc-colors
    _rgb=$(resolve_color "$1")
    if [[ -n "$_rgb" ]]; then
      read -r _r _g _b <<< "$_rgb"
      output_seq "$(make_seq "$_r" "$_g" "$_b")"
      exit 0
    fi
    echo "Unknown: $1 (try 'tc help')" >&2
    exit 1
    ;;
esac
