  tc sage               # nice muted green
  tc join 3.1 8.1       # tile two windows left/right
  tc join 1.1 3.1 5.1   # tile three windows in thirds
  tc hanabi             # fireworks: every tab in this window a different color
  tc which seminar      # the win.tab running prj's 'seminar' session
  tc which acb74eaa     # same, by session UUID prefix (as prj reports it)
  tc which              # every claude tab, with its launch UUID
  tc hanabi all         # every tab of every window

# blingbling (Color Name API - api.color.pizza)
  tc search <keyword>              # find color by name, apply best match, save it
  tc palette <keyword> [n]         # show matches, pick interactively or by number
  tc name <r> <g> <b>             # what's this color called?
