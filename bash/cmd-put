#!/bin/bash
# cmd-put SLUG BODYFILE [TEXTFILE]
#
# Stage a command Claude wants Chris to run as an executable script at
# /tmp/cmd/NR-SLUG.sh, where NR = 1 + the largest NR already present in
# /tmp/cmd/*.sh (1 if none). Chris then runs it with `bash /tmp/cmd/NR-SLUG.sh`
# without needing to paste multi-line text (the harness clipboard mangles \n).
#
# BODYFILE is a file Claude wrote (with the Write tool) holding the exact
# command(s). It is copied in with a shebang.
#
# TEXTFILE (optional) is the editable message payload for the command (an email
# body, a Slack message). It is written to /tmp/doc/NR-SLUG.sh.txt, RIGHT NEXT to
# the script by number and slug, so Chris can edit the text in a well-named file
# before running the script. In BODYFILE, write the placeholder {TXT} wherever
# the payload path goes; cmd-put substitutes the real /tmp/doc/NR-SLUG.sh.txt
# path. This keeps the load-bearing text out of a garbage scratchpad path.
#
# RECEIPT: every staged script tees its stdout and stderr, bracketed by a start
# line and an exit-status line, to /tmp/out/NR-SLUG.out. That lets Claude read
# what actually went out (a Slack ts, a sent message id, an error) after Chris
# runs it, and check that against the destination, instead of trusting that it
# ran. --no-receipt skips this for scripts that open an interactive program
# (vim, a pager), which misbehaves when stdout is a pipe.
#
# RUN ONCE: a script with a receipt refuses to run if its receipt already has a
# "=== start" line (exit 3), so a command pasted into a second window cannot
# post or send twice. FORCE=1 bash /tmp/cmd/NR-SLUG.sh overrides.
#
# Prints, on success, the script path, the editable text path (if any), the
# receipt path, and the `bash <path>` line to hand Chris.
#
# CMD_DIR, CMD_DOC_DIR, CMD_OUT_DIR override the three directories (for tests).
set -euo pipefail

dir=${CMD_DIR:-/tmp/cmd}
docdir=${CMD_DOC_DIR:-/tmp/doc}
outdir=${CMD_OUT_DIR:-/tmp/out}
mkdir -p "$dir" "$docdir" "$outdir"

receipt=1
if [ "${1:-}" = "--no-receipt" ]; then
    receipt=0
    shift
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    echo "usage: cmd-put [--no-receipt] SLUG BODYFILE [TEXTFILE]" >&2
    exit 2
fi
slug=$1
body=$2
textfile=${3:-}

if [ ! -f "$body" ]; then
    echo "cmd-put: body file not found: $body" >&2
    exit 2
fi
# A Slack post's text goes INSIDE the script, so Chris reads what he approves (2026-10-04: "put the text
# IN the bash not in separate txt file"). Use: read -r -d '' MSG <<'EOF' ... EOF, then --text "$MSG".
if /usr/bin/grep -qE 'slack-post.*--file' "$body"; then
    echo "cmd-put: refused: slack-post --file keeps the message outside the script; put the text inline (read -r -d '' MSG <<'EOF' ... EOF; --text \"\$MSG\")" >&2
    exit 2
fi
# slack-post reads $SLACK_TOKEN, else ~/.config/slack/token; a workspace-specific token must be
# exported in the script itself, or Chris runs it and gets "no token" (2026-10-06: two staged posts died this way).
if /usr/bin/grep -q 'slack-post' "$body" && ! /usr/bin/grep -q 'SLACK_TOKEN=' "$body"; then
    echo "cmd-put: refused: script calls slack-post but never sets SLACK_TOKEN; add export SLACK_TOKEN=\"\$(head -1 <token file>)\"" >&2
    exit 2
fi
if [ -n "$textfile" ] && [ ! -f "$textfile" ]; then
    echo "cmd-put: text file not found: $textfile" >&2
    exit 2
fi

# slug sanity: short, memorable, filename-safe
if ! printf '%s' "$slug" | grep -qE '^[a-z0-9][a-z0-9-]{0,39}$'; then
    echo "cmd-put: slug must be lowercase a-z0-9 and dashes, <=40 chars: $slug" >&2
    exit 2
fi

# NR = 1 + largest leading integer among /tmp/cmd/<n>-*.sh
max=0
for f in "$dir"/*.sh; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    n=${base%%-*}
    if printf '%s' "$n" | grep -qE '^[0-9]+$'; then
        [ "$n" -gt "$max" ] && max=$n
    fi
done
nr=$((max + 1))

out="$dir/$nr-$slug.sh"
rcpt="$outdir/$nr-$slug.out"
txtout=""

# If a text payload was given, place it beside the script by NR+slug and make
# the body reference it via {TXT}.
if [ -n "$textfile" ]; then
    txtout="$docdir/$nr-$slug.sh.txt"
    cp "$textfile" "$txtout"
    # substitute {TXT} in the body with the real editable-text path
    bodytext=$(sed "s#{TXT}#$txtout#g" "$body")
else
    bodytext=$(cat "$body")
fi

{
    echo "#!/bin/bash"
    echo "# staged by cmd-put $(date '+%Y-%m-%d %H:%M:%S') -- run: bash $out"
    if [ -n "$txtout" ]; then
        echo "# editable message text: $txtout  (edit this, then run the script)"
    fi
    if [ "$receipt" = 1 ]; then
        # Run the body in a subshell piped through tee, so the receipt is
        # complete when the script returns (macOS bash 3.2 cannot wait on an
        # exec'd process substitution). stdin stays the terminal.
        echo "# receipt: $rcpt"
        echo "__rcpt=$rcpt"
        # Run once: a receipt with a start line means this script already ran. 2026-10-09: 145 was run in
        # two windows two minutes apart and a student got four Slack posts twice. FORCE=1 overrides.
        echo 'if [ -f "$__rcpt" ] && /usr/bin/grep -q "^=== start" "$__rcpt" && [ "${FORCE:-}" != 1 ]; then'
        echo '    echo "REFUSED: $0 already ran ($(/usr/bin/grep "^=== start" "$__rcpt" | tail -1)). To run it again anyway: FORCE=1 bash $0" >&2'
        echo '    exit 3'
        echo 'fi'
        echo 'echo "=== start $(date '"'"'+%Y-%m-%d %H:%M:%S'"'"') $0 ===" >> "$__rcpt"'
        echo '('
        printf '%s\n' "$bodytext"
        echo ') 2>&1 | tee -a "$__rcpt"'
        echo '__rc=${PIPESTATUS[0]}'
        echo 'echo "=== exit $__rc $(date '"'"'+%Y-%m-%d %H:%M:%S'"'"') ===" >> "$__rcpt"'
        echo 'echo "receipt: $__rcpt"'
        echo 'exit $__rc'
    else
        printf '%s\n' "$bodytext"
    fi
} > "$out"
chmod +x "$out"

echo "wrote $out"
if [ -n "$txtout" ]; then
    echo "edit text: $txtout"
fi
if [ "$receipt" = 1 ]; then
    echo "receipt: $rcpt"
fi
echo "run it:  bash $out"
