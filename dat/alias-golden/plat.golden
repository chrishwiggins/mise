$ plat
pdflatex --shell-escape :r ; bibtex :r ; pdflatex --shell-escape :r ; pdflatex --shell-escape :r ; grep Citation :r.log 
$ plat ARG1 ARG2
pdflatex --shell-escape ARG1 ARG2:r ; bibtex ARG1 ARG2:r ; pdflatex --shell-escape ARG1 ARG2:r ; pdflatex --shell-escape ARG1 ARG2:r ; grep Citation ARG1 ARG2:r.log
