#!/usr/bin/env python3.11
"""git-hunks: stage part of a file when several sessions share one working tree.

  git-hunks list  REPO PATH
      Number every `git diff -U0` hunk of PATH with its line range and first
      changed lines, so hunks can be picked by number.

  git-hunks build REPO PATH IDS OUT [--insert-after N LINESFILE]...
      Write HEAD:PATH plus only the chosen hunks (IDS like 1,4,7) to OUT.
      Hunks are applied bottom-up in HEAD line coordinates, so earlier hunks
      never shift later ones, and each hunk's removed lines are asserted to
      match HEAD. --insert-after adds lines that no single hunk holds (half
      of a mixed hunk). Stage the result with:
        git -C REPO update-index --cacheinfo 100755,$(git -C REPO hash-object -w OUT),PATH

Why: on 2026-09-29 two `git apply --cached --unidiff-zero` patches applied one
after the other misplaced four lines, because the second patch's line numbers
predated the first. Building the staged file from HEAD in one pass cannot drift.
"""
import re
import subprocess
import sys


def diff_hunks(repo, path):
    diff = subprocess.run(["git", "-C", repo, "diff", "-U0", "--", path],
                          capture_output=True, text=True, check=True).stdout
    hunks, cur = [], None
    for line in diff.splitlines(keepends=True):
        m = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", line)
        if m:
            cur = {"start": int(m.group(1)),
                   "n": int(m.group(2) if m.group(2) is not None else 1),
                   "head": line.strip(), "old": [], "new": []}
            hunks.append(cur)
        elif cur is not None and line.startswith("-") and not line.startswith("---"):
            cur["old"].append(line[1:])
        elif cur is not None and line.startswith("+") and not line.startswith("+++"):
            cur["new"].append(line[1:])
    return hunks


def cmd_list(repo, path):
    for i, h in enumerate(diff_hunks(repo, path), 1):
        print(f"#{i} {h['head'].split('@@')[1].strip()} +{len(h['new'])}/-{len(h['old'])}")
        for line in (h["new"] or ["-" + x for x in h["old"]])[:3]:
            print("     " + line.rstrip("\n")[:150])


def cmd_build(repo, path, ids, out, rest):
    want = {int(x) for x in ids.split(",") if x}
    head = subprocess.run(["git", "-C", repo, "show", f"HEAD:{path}"],
                          capture_output=True, text=True, check=True).stdout.splitlines(keepends=True)
    hunks = diff_hunks(repo, path)
    unknown = want - set(range(1, len(hunks) + 1))
    if unknown:
        sys.exit(f"git-hunks: no hunk(s) {sorted(unknown)}; {path} has {len(hunks)}")
    edits = []
    for i, h in enumerate(hunks, 1):
        if i in want:
            # -U0: a pure insertion (n == 0) names the line AFTER which to insert
            idx = h["start"] if h["n"] == 0 else h["start"] - 1
            if head[idx:idx + h["n"]] != h["old"]:
                sys.exit(f"git-hunks: hunk #{i} does not match HEAD at line {h['start']}")
            edits.append((idx, h["n"], h["new"]))
    while rest:
        if len(rest) < 3 or rest[0] != "--insert-after":
            sys.exit("git-hunks: extra arguments must be --insert-after N LINESFILE")
        edits.append((int(rest[1]), 0, open(rest[2]).read().splitlines(keepends=True)))
        rest = rest[3:]
    for idx, n, new in sorted(edits, key=lambda e: e[0], reverse=True):
        head[idx:idx + n] = new
    with open(out, "w") as fh:
        fh.write("".join(head))
    print(f"git-hunks: {len(edits)} edit(s) from {len(hunks)} hunk(s) -> {out}")


def main(argv):
    if len(argv) >= 3 and argv[0] == "list":
        cmd_list(argv[1], argv[2])
    elif len(argv) >= 5 and argv[0] == "build":
        cmd_build(argv[1], argv[2], argv[3], argv[4], argv[5:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
