#!/usr/bin/env python3
"""sent-verify: prove a drafted email was actually sent, and show what changed.

Given a draft file with To:/Subject: headers, search the Gmail sent archive of
one or more configured accounts (via gmails -e <acct> out -q ...) for a message
with that exact subject, download the newest hit, and diff its body against the
draft body.

Exit codes:
  0  found (prints IDENTICAL or a unified diff)
  1  not found in ANY searched account, and every account answered
  2  usage/tool error
  3  no hit where answered, but at least one account TIMED OUT, so the result
     is UNKNOWN. Never read 3 as "not sent".

Each gmails call is abandoned after --timeout seconds (default 60, or
$GMAILS_TIMEOUT). Added 2026-10-04: gmails children sat for 72 minutes (and two
others for 8 days) waiting on a browser OAuth consent nobody would give, and
sent-verify printed nothing the whole time.

Usage:
  sent-verify DRAFT.eml [-e ACCT ...] [--days N] [--timeout SECONDS]

Accounts default to every account listed by `gmails -E`. Search scope is
printed explicitly so a "not found" carries its scope with it.
"""
import argparse
import difflib
import email
import email.policy
import os
import re
import subprocess
import sys
from pathlib import Path

GMAILS = Path.home() / "mise/py/gmails"
EXIT_TIMEOUT = 3
TIMEOUT = float(os.environ.get("GMAILS_TIMEOUT", "60"))


class GmailsTimeout(Exception):
    pass


def run_gmails(args):
    """Run gmails with a hard deadline; subprocess.run kills the child on expiry."""
    try:
        return subprocess.run([str(GMAILS)] + args, capture_output=True, text=True,
                              timeout=TIMEOUT, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise GmailsTimeout()


def parse_draft(path: Path):
    to = subject = None
    lines = path.read_text(errors="replace").splitlines()
    body_start = 0
    for i, line in enumerate(lines):
        if not line.strip():
            body_start = i + 1
            break
        if line.lower().startswith("to:"):
            to = line[3:].strip()
        elif line.lower().startswith("subject:"):
            subject = line[8:].strip()
    body = "\n".join(lines[body_start:])
    return to, subject, body


def list_accounts():
    out = run_gmails(["-E"]).stdout
    accts = []
    seen = set()
    for line in out.splitlines():
        m = re.match(r"\s*(\S+):\s+(\S+@\S+)", line)
        if m and m.group(2) not in seen:
            seen.add(m.group(2))
            accts.append(m.group(1))
    return accts


def search(acct: str, subject: str, days: int):
    q = f'subject:"{subject}" newer_than:{days}d'
    r = run_gmails(["-e", acct, "out", "-q", q, "-n", "5"])
    hits = [l for l in r.stdout.splitlines() if re.match(r"\s*\d+\.\s", l)]
    return hits, q


def download(acct: str, q: str):
    r = run_gmails(["-e", acct, "out", "-q", q, "1"])
    m = re.search(r"Saved:\s+(\S+\.eml)", r.stdout + r.stderr)
    return Path(m.group(1)) if m else None


def strip_history(text: str) -> str:
    """Cut at the first quoted line or attribution line. Applied to BOTH the
    draft and the sent copy, so a reply's quoted block never shows up as a
    bogus diff (caught 2026-09-13: a verbatim send diffed as 40 deleted lines)."""
    kept = []
    for line in text.splitlines():
        if line.startswith(">") or re.match(r"^On .* wrote:$", line.strip()):
            break
        kept.append(line.rstrip())
    return "\n".join(kept)


def eml_body(path: Path) -> str:
    msg = email.message_from_bytes(path.read_bytes(), policy=email.policy.default)
    part = msg.get_body(preferencelist=("plain",))
    return strip_history(part.get_content() if part else "")


def eml_attachments(path: Path):
    """Names and sizes of the attachment parts in the sent copy.

    Added 2026-09-13 after a message promising an exam PDF went out as
    single-part text (the -a flag was lost to a wrapped command line) and the
    gap was only noticed by hand-inspecting the MIME structure afterward."""
    msg = email.message_from_bytes(path.read_bytes(), policy=email.policy.default)
    out = []
    for part in msg.walk():
        name = part.get_filename()
        if name:
            payload = part.get_payload(decode=True) or b""
            out.append((name, part.get_content_type(), len(payload)))
    return out


PROMISE_WORDS = re.compile(r"\battach(ed|ing|ment|ments)?\b|\benclosed\b", re.I)

# A promise to attach is FIRST PERSON. "the detail you attached" and "the form
# she attached" refer to someone ELSE's file and must not warn. Caught
# 2026-09-13: a reply acknowledging Shania Lu's own attachment ("I have
# reviewed the salary and expense detail you attached") warned that the -a flag
# had probably been lost, on a message that was never meant to carry one.
# strip_history() already drops the quoted original, so this only has to handle
# new text.
OTHERS_ATTACHMENT = re.compile(
    r"\b(you|your|she|her|he|his|they|their)\s+(\w+\s+){0,2}attach(ed|ing|es)?\b"
    r"|\battach(ed|ment|ments)?\b[^.\n]{0,40}\b(you|she|he|they)\s+sent\b",
    re.I)


def promises_attachment(text: str) -> bool:
    """True only where the writer says THEY are attaching something."""
    for line in text.splitlines():
        if PROMISE_WORDS.search(line) and not OTHERS_ATTACHMENT.search(line):
            return True
    return False


def norm(s: str):
    return [l.strip() for l in strip_history(s).splitlines() if l.strip()]


def main():
    global TIMEOUT
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("draft", type=Path)
    ap.add_argument("-e", "--account", action="append", help="gmails account key; repeatable")
    ap.add_argument("--days", type=int, default=3, help="newer_than window (default 3)")
    ap.add_argument("--timeout", type=float, default=TIMEOUT,
                    help="seconds before one gmails call is abandoned "
                         "(default 60 or $GMAILS_TIMEOUT)")
    a = ap.parse_args()
    TIMEOUT = a.timeout

    if not a.draft.exists():
        print(f"no such draft: {a.draft}", file=sys.stderr)
        return 2
    to, subject, draft_body = parse_draft(a.draft)
    if not subject:
        print("draft has no Subject: header", file=sys.stderr)
        return 2
    try:
        accts = a.account or list_accounts()
    except GmailsTimeout:
        print(f"gmails -E TIMED OUT after {TIMEOUT:g}s; accounts unknown, result unknown",
              file=sys.stderr)
        return EXIT_TIMEOUT
    if not accts:
        print("no gmails accounts found (gmails -E)", file=sys.stderr)
        return 2

    print(f"draft:   {a.draft}")
    print(f"to:      {to}")
    print(f"subject: {subject}")
    print(f"scope:   sent mail, last {a.days}d, accounts {', '.join(accts)}")
    timed_out = []
    for acct in accts:
        try:
            hits, q = search(acct, subject, a.days)
        except GmailsTimeout:
            print(f"  {acct}: TIMED OUT after {TIMEOUT:g}s, result unknown", flush=True)
            timed_out.append(acct)
            continue
        if not hits:
            print(f"  {acct}: no hit")
            continue
        print(f"  {acct}: FOUND  {hits[0].strip()}")
        try:
            saved = download(acct, q)
        except GmailsTimeout:
            print(f"  (download TIMED OUT after {TIMEOUT:g}s; sent copy not diffed)")
            return 0
        if not saved:
            print("  (could not download the sent copy to diff)")
            return 0
        sent_body = eml_body(saved)
        d = list(difflib.unified_diff(norm(draft_body), norm(sent_body),
                                      "draft", "sent", lineterm=""))
        if d:
            print("body differs (draft -> sent):")
            print("\n".join(d))
            # A large diff on a standing thread usually means the subject matched a
            # DIFFERENT message, not that this draft went out and was edited.
            # Verified 2026-09-13: two drafts on threads whose subject never changes
            # ("Re: In Paris late March", "Re: Institute member") each matched an
            # older scheduling message, printing a convincing diff for a draft that
            # had never been sent. Subject equality is not identity.
            # Compare CONTENT, not line counts: greetings and sign-offs survive any
            # match and inflate the "kept" side, so a wholesale body replacement can
            # still show more context lines than removed ones.
            gone = sum(len(x) - 1 for x in d
                       if x.startswith("-") and not x.startswith("---"))
            stayed = sum(len(x) - 1 for x in d if x.startswith(" "))
            if gone > max(stayed, 40):
                print()
                print("WARNING: most of the draft body is absent from the matched message.")
                print("On a thread whose subject never changes, that usually means the "
                      "subject matched a DIFFERENT message rather than an edited send.")
                print("Confirm by recipient and date before trusting this:")
                print(f'  gmails -e {acct} out -q "to:{to} after:YYYY/MM/DD"')
                print("then read the hit bodies for a distinctive phrase from this draft.")
        else:
            print("body IDENTICAL to draft")
        atts = eml_attachments(saved)
        if atts:
            print("attachments: " + "; ".join(f"{n} ({t}, {s} bytes)" for n, t, s in atts))
        else:
            print("attachments: none")
            if promises_attachment(strip_history(draft_body)):
                print("WARNING: the draft body mentions an attachment and the sent copy has none;"
                      " the -a flag was probably lost. Send the file in a follow-up.")
        return 0
    if timed_out:
        msg = (f"UNKNOWN: no hit in the accounts that answered, but {', '.join(timed_out)} "
               f"TIMED OUT after {TIMEOUT:g}s. This is NOT a 'not sent' result; rerun "
               "later or check gmails auth for that account.")
        print(msg)
        if not sys.stdout.isatty():
            print(msg, file=sys.stderr)
        return EXIT_TIMEOUT
    print("NOT FOUND in the accounts above within the window; do not mark as sent.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
