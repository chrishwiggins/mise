#!/usr/bin/env python3
"""Print the next free /tmp/bus task number.

Other Claude sessions write to the same /tmp/bus concurrently, so a number that
was free when you started composing may be taken by the time you write. Call this
immediately before writing, and again after, to confirm you still own it.

Usage:
    next-bus-num              # print next free number
    next-bus-num --check 59   # exit 0 if 59 is free, 1 if taken (prints owner)
"""
import re
import sys
from pathlib import Path

BUS = Path("/tmp/bus")


def used():
    """Every number claimed by a prompt file, an out-NN, or a report-NN."""
    nums = set()
    if not BUS.is_dir():
        return nums
    for f in BUS.iterdir():
        for pat in (r"^(\d+)-", r"^out-(\d+)", r"^report-(\d+)"):
            m = re.match(pat, f.name)
            if m:
                nums.add(int(m.group(1)))
    return nums


def main():
    taken = used()
    if len(sys.argv) > 2 and sys.argv[1] == "--check":
        n = int(sys.argv[2])
        if n in taken:
            owners = sorted(p.name for p in BUS.iterdir() if re.match(rf"^(out-|report-)?0*{n}\b", p.name))
            print(f"{n} is TAKEN by: {', '.join(owners)}", file=sys.stderr)
            return 1
        print(f"{n} is free")
        return 0
    print(max(taken) + 1 if taken else 1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
