"""
calzoom (also `zooms`) - Quick access to nearby Zoom / Meet / Hangout calls.

Looks across every calendar account with a token on disk (the same set
`gcal-list --all` reads) for events carrying a Zoom or Google Meet link in the
window around now: 2 hours back (in case you are late) and 2 hours ahead.

Always shows a menu, even for a single call; nothing opens until you choose.
Opens the selected meeting in both Zoom app and web browser.

Usage:
    calzoom                     Find and open Zoom meetings
    calzoom -l                  List Zoom meetings without opening
    calzoom -w HOURS            Set time window (default: 4 hours total)
    calzoom -1                  Personal (primary) calendar only
"""

import argparse
import importlib.machinery
import importlib.util
import re
import subprocess
import sys
import webbrowser
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

from googleapiclient.discovery import build
from googleapiclient.errors import HttpError

sys.path.insert(0, str(Path(__file__).parent))
from google_auth import get_credentials

LOCAL_TZ = ZoneInfo("America/New_York")


def _load_gcal_list():
    """gcal-list owns the account/token conventions; reuse them, don't fork them."""
    path = str(Path(__file__).resolve().parent / "gcal-list")
    loader = importlib.machinery.SourceFileLoader("gcal_list", path)
    spec = importlib.util.spec_from_loader("gcal_list", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


gcal_list = _load_gcal_list()


def get_calendar_service(account=None):
    return gcal_list.get_calendar_service(account)


def extract_zoom_urls(text):
    """Extract Zoom URLs from text (description, location, etc.)"""
    if not text:
        return []

    # Match various Zoom URL patterns
    zoom_patterns = [
        r'https://[a-zA-Z0-9.-]*\.?zoom\.us/j/[0-9]+[^\s]*',
        r'https://[a-zA-Z0-9.-]*\.?zoom\.us/s/[0-9]+[^\s]*',
        r'https://[a-zA-Z0-9.-]*\.?zoom\.us/my/[a-zA-Z0-9._-]+[^\s]*',
        r'https://[a-zA-Z0-9.-]*\.?zoom\.us/webinar/[a-zA-Z0-9]+[^\s]*',
        r'zoommtg://[^\s]+',
        r'https://meet\.google\.com/[a-z]{3}-[a-z]{4}-[a-z]{3}',
        r'https://hangouts\.google\.com/[^\s"<>]+',
    ]

    urls = []
    for pattern in zoom_patterns:
        urls.extend(re.findall(pattern, text, re.IGNORECASE))

    # Clean up URLs (remove trailing punctuation)
    cleaned_urls = []
    for url in urls:
        url = re.sub(r'[.,;!?]+$', '', url)
        if url not in cleaned_urls:
            cleaned_urls.append(url)

    return cleaned_urls


def fetch_zoom_meetings(accounts, window_hours=4):
    """Fetch meetings with Zoom/Meet URLs in the time window around now.

    Reads the primary calendar of each account; an account whose token is
    broken is reported on stderr and skipped rather than killing the rest.
    """
    now = datetime.now(LOCAL_TZ)
    start_time = now - timedelta(hours=window_hours/2)
    end_time = now + timedelta(hours=window_hours/2)

    events = []
    for account in accounts:
        try:
            result = get_calendar_service(account).events().list(
                calendarId="primary",
                timeMin=start_time.isoformat(),
                timeMax=end_time.isoformat(),
                singleEvents=True,
                orderBy="startTime",
            ).execute()
        except Exception as e:
            print(f"⚠ {account}: could not read calendar: {e}", file=sys.stderr)
            continue
        for ev in result.get("items", []):
            ev["_account"] = account
            events.append(ev)

    zoom_meetings = []
    seen = set()

    for event in events:
        # Skip all-day events
        start = event.get("start", {})
        if "date" in start:
            continue

        # Look for Zoom URLs in various fields
        zoom_urls = []

        # Google Meet / Hangouts links live in structured fields, not the text
        if event.get("hangoutLink"):
            zoom_urls.append(event["hangoutLink"])
        for ep in event.get("conferenceData", {}).get("entryPoints", []):
            if ep.get("entryPointType") == "video" and ep.get("uri"):
                zoom_urls.append(ep["uri"])

        # Check location field
        location = event.get("location", "")
        zoom_urls.extend(extract_zoom_urls(location))

        # Check description
        description = event.get("description", "")
        zoom_urls.extend(extract_zoom_urls(description))

        # Check summary/title for zoom references
        summary = event.get("summary", "")
        if "zoom" in summary.lower():
            zoom_urls.extend(extract_zoom_urls(description + " " + location))

        zoom_urls = [u for i, u in enumerate(zoom_urls) if u not in zoom_urls[:i]]
        # One invite on two calendars (you invited yourself) shows up twice
        key = (event.get("iCalUID"), start["dateTime"])
        if zoom_urls and key not in seen:
            seen.add(key)
            start_dt = datetime.fromisoformat(start["dateTime"])
            end_dt = datetime.fromisoformat(event["end"]["dateTime"])

            meeting = {
                "event": event,
                "summary": summary,
                "start": start_dt,
                "end": end_dt,
                "zoom_urls": zoom_urls,
                "account": event["_account"],
            }
            zoom_meetings.append(meeting)

    # Sort by start time
    zoom_meetings.sort(key=lambda m: m["start"])
    return zoom_meetings


def format_time(dt):
    """Format datetime for display."""
    return dt.strftime("%-I:%M%p").lower()


def format_meeting(meeting, index=None):
    """Format meeting for display."""
    prefix = f"{index:2d}. " if index is not None else "    "
    start_str = format_time(meeting["start"])
    end_str = format_time(meeting["end"])
    time_range = f"{start_str}-{end_str}"

    # Show time until/since meeting
    now = datetime.now(LOCAL_TZ)
    delta = meeting["start"] - now

    if delta.total_seconds() > 0:
        mins = int(delta.total_seconds() // 60)
        if mins < 60:
            timing = f"in {mins}m"
        else:
            hours = mins // 60
            remaining_mins = mins % 60
            timing = f"in {hours}h{remaining_mins}m" if remaining_mins else f"in {hours}h"
    else:
        delta = now - meeting["start"]
        mins = int(delta.total_seconds() // 60)
        if meeting["end"] > now:
            timing = f"started {mins}m ago"
        else:
            timing = f"ended {mins}m ago"

    label = gcal_list.account_label(meeting["account"])
    kind = "meet" if "google.com" in meeting["zoom_urls"][0] else "zoom"
    return f"{prefix}{label} {kind} {time_range:17s} {meeting['summary']} ({timing})"


def open_zoom_meeting(meeting):
    """Open a Zoom meeting in both app and browser."""
    zoom_url = meeting["zoom_urls"][0]  # Use first URL found

    print(f"Opening: {meeting['summary']}")
    print(f"Time: {format_time(meeting['start'])}-{format_time(meeting['end'])}")
    print(f"URL: {zoom_url}")

    # Meet/Hangouts have no desktop app; the browser is the only route
    if "google.com" in zoom_url:
        webbrowser.open(zoom_url)
        print("✓ Opened in browser")
        return

    # Open in Zoom app (try zoommtg:// protocol first)
    if zoom_url.startswith("https://"):
        zoom_app_url = zoom_url.replace("https://", "zoommtg://")
    else:
        zoom_app_url = zoom_url

    try:
        subprocess.run(["open", zoom_app_url], check=True)
        print("✓ Opened in Zoom app")
    except subprocess.CalledProcessError:
        print("⚠ Could not open Zoom app")

    # Open in browser as backup
    try:
        # Convert back to https for browser
        if zoom_url.startswith("zoommtg://"):
            browser_url = zoom_url.replace("zoommtg://", "https://")
        else:
            browser_url = zoom_url
        webbrowser.open(browser_url)
        print("✓ Opened in browser")
    except Exception as e:
        print(f"⚠ Could not open browser: {e}")


def main():
    parser = argparse.ArgumentParser(
        description="Find and open upcoming Zoom meetings",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-l", "--list",
        action="store_true",
        help="List Zoom meetings without opening"
    )
    parser.add_argument(
        "-w", "--window",
        type=int,
        default=4,
        help="Time window in hours to search (default: 4)"
    )

    parser.add_argument(
        "-1", "--primary",
        action="store_true",
        help="Personal calendar only (the old behavior)"
    )

    args = parser.parse_args()

    if args.primary:
        accounts = [gcal_list.DEFAULT_TOKEN_ACCOUNT]
    else:
        accounts = gcal_list.authorized_accounts() or [gcal_list.DEFAULT_TOKEN_ACCOUNT]
    labels = ",".join(gcal_list.account_label(a) for a in accounts)
    meetings = fetch_zoom_meetings(accounts, args.window)
    # Never let silence imply coverage: say which calendars were read
    footer = f"(read: {labels}; not read: CNN Outlook)"

    if not meetings:
        print(f"No Zoom/Meet calls within {args.window/2:g}h either side of now. {footer}")
        return

    if args.list:
        print(f"Zoom/Meet calls, {args.window/2:g}h either side of now {footer}:")
        print()
        for i, meeting in enumerate(meetings, 1):
            print(format_meeting(meeting, i))
        print()
        return

    # Always show the menu, even for one call: never open without a choice
    print(f"Found {len(meetings)} Zoom/Meet calls {footer}:")
    print()
    for i, meeting in enumerate(meetings, 1):
        print(format_meeting(meeting, i))
    print()

    while True:
        try:
            choice = input("Choose meeting (1-{}, or 'q' to quit): ".format(len(meetings))).strip()

            if choice.lower() == 'q':
                print("Cancelled.")
                return

            try:
                index = int(choice)
                if 1 <= index <= len(meetings):
                    selected = meetings[index - 1]
                    print()
                    open_zoom_meeting(selected)
                    return
                else:
                    print(f"Please enter a number between 1 and {len(meetings)}")
            except ValueError:
                print("Please enter a number or 'q' to quit")

        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            return


if __name__ == "__main__":
    main()