#!/usr/bin/env python3.11
"""last-with: what was last said to and from one person, in EVERY account.

A thread does not stay in one mailbox. A correspondent answers whichever
address wrote last, so a conversation that began in the Columbia account can
continue in the personal one, and a search of a single account then shows a
stale message as the newest. Run this before drafting anything to a person.

usage: last-with <fragment> [days]

  fragment   local-part or name fragment, e.g. bt2314 or maceo (no @ needed)
  days       how far back to look, default 7

Prints, per distinct account, the inbound and outbound listings that gmails
returns for from:<fragment> and to:<fragment>. Read-only.
"""
import subprocess
import sys
from pathlib import Path

GMAILS = str(Path(__file__).resolve().parent / "gmails")


def accounts():
    """Distinct accounts from `gmails -E`, first alias wins per address."""
    out = subprocess.run([GMAILS, "-E"], capture_output=True, text=True).stdout
    seen, result = set(), []
    for line in out.splitlines():
        if ":" not in line:
            continue
        alias, _, addr = line.strip().partition(":")
        addr = addr.strip()
        if addr and addr not in seen:
            seen.add(addr)
            result.append((alias.strip(), addr))
    return result


def listing(alias, query, outbound):
    cmd = [GMAILS, "-e", alias]
    if outbound:
        cmd.append("out")
    cmd += ["-q", query]
    res = subprocess.run(cmd, capture_output=True, text=True)
    rows = [l for l in res.stdout.splitlines() if l.strip()]
    return rows


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0 if len(sys.argv) >= 2 else 2
    frag = sys.argv[1]
    days = sys.argv[2] if len(sys.argv) > 2 else "7"
    accts = accounts()
    if not accts:
        print("last-with: gmails -E listed no accounts", file=sys.stderr)
        return 1
    total = 0
    for alias, addr in accts:
        inbound = listing(alias, f"from:{frag} newer_than:{days}d", False)
        outbound = listing(alias, f"to:{frag} newer_than:{days}d", True)
        hits = [r for r in inbound + outbound if "No messages found" not in r]
        if not hits:
            continue
        print(f"## {alias} ({addr})")
        if any("No messages found" not in r for r in inbound):
            print("  FROM them:")
            for r in inbound:
                print("   ", r)
        if any("No messages found" not in r for r in outbound):
            print("  TO them:")
            for r in outbound:
                print("   ", r)
        total += 1
    if total == 0:
        # A zero here is a claim Chris may act on ("she has not written"), and the
        # likeliest cause is a WRONG FRAGMENT rather than real silence. So prove the
        # probe ran: widen the same query to a year, and if that hits, the fragment is
        # fine and the silence is real; if a year is also empty, say the fragment
        # matches nothing ever, which is a different finding and usually a typo.
        ever = 0
        for alias, _addr in accts:
            rows = listing(alias, f"from:{frag} newer_than:365d", False)
            rows += listing(alias, f"to:{frag} newer_than:365d", True)
            ever += sum(1 for r in rows if "No messages found" not in r)
        acct_list = ", ".join(a for a, _ in accts)
        if ever:
            print(f"nothing to or from '{frag}' in the last {days}d, "
                  f"searched {len(accts)} accounts: {acct_list}")
            print(f"  (fragment is good: {ever} message(s) in the last 365d, "
                  f"so this silence is real for this window)")
        else:
            print(f"NO MESSAGES EVER for fragment '{frag}' in {len(accts)} accounts "
                  f"({acct_list}), searched 365d.")
            print("  Do NOT report this as 'they have not written'. A fragment that")
            print("  matches nothing in a year is almost always wrong: try the")
            print("  local-part of their actual address, or a distinctive name word.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
