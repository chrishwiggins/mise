#!/usr/bin/env python3
import os
import sys
import argparse

# The normalizer lives in fname_norm.py so gmail-api-rw saves attachments
# under the same names this tool would give them.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from fname_norm import normalize_basename  # noqa: E402


def normalize_name(path):
    """Normalize the last component of path (see fname_norm.normalize_basename)."""
    dirpath, basename = os.path.split(path)
    placeholder = "dir" if os.path.isdir(path) else "file"
    return os.path.join(dirpath, normalize_basename(basename, placeholder))


def unique_path(path, used):
    """Return a unique path by appending _N suffix if needed."""
    if path not in used and not os.path.exists(path):
        return path
    dirpath, basename = os.path.split(path)
    root, ext = os.path.splitext(basename)
    counter = 1
    while True:
        candidate = os.path.join(dirpath, f"{root}_{counter}{ext}")
        if candidate not in used and not os.path.exists(candidate):
            return candidate
        counter += 1


def rename_path(old_path, used_paths, dry_run):
    new_path = normalize_name(old_path)
    if new_path != old_path:
        new_path = unique_path(new_path, used_paths)
        print(f"Renaming: {old_path} -> {new_path}")
        if not dry_run:
            os.makedirs(os.path.dirname(new_path), exist_ok=True)
            os.rename(old_path, new_path)
    used_paths.add(new_path)


def main():
    parser = argparse.ArgumentParser(
        description="Normalize file and directory names by removing bracketed IDs and cleaning punctuation."
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Directory to process (default: current directory)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be renamed without making changes",
    )
    parser.add_argument(
        "-local", "--local",
        action="store_true",
        help="Only process files in the specified directory, do not recurse",
    )
    args = parser.parse_args()

    used_paths = set()
    if args.local:
        for name in os.listdir(args.directory):
            rename_path(os.path.join(args.directory, name), used_paths, args.dry_run)
    else:
        for dirpath, dirnames, filenames in os.walk(args.directory, topdown=False):
            for filename in filenames:
                rename_path(os.path.join(dirpath, filename), used_paths, args.dry_run)
            for dirname in dirnames:
                rename_path(os.path.join(dirpath, dirname), used_paths, args.dry_run)


if __name__ == "__main__":
    main()
