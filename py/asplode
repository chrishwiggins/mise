#!/usr/bin/env python3
"""
asplode - give every window its own macOS desktop, then close the empties.

Spaces accumulate lopsidedly: one desktop ends up with seven windows on it
while a dozen others sit empty. asplode redistributes them so the mapping is
one window <-> one space, then removes any space left with nothing on it.

Finally it sorts the desktops so every iTerm2 window running Claude sits to the
LEFT of everything else, keeping the relative order within each group.

Usage:
    asplode              plan and apply
    asplode -n           dry run: print the plan, change nothing
    asplode -v           verbose (show per-move detail)
    asplode --no-sort    skip the Claude-left reordering

Native-fullscreen windows are left alone: macOS already gives each one its own
space, and yabai refuses to move windows into or out of them.

REQUIRES yabai's scripting addition. Without it yabai cannot create spaces, and
window moves fail SILENTLY (exit 0, window does not move), so every move here is
verified by re-querying rather than trusted. Install with:

    sudo yabai --load-sa

and make it persistent via a sudoers entry (see yabai's wiki). asplode checks
the addition up front and refuses to run a partial redistribution without it.
"""

import argparse
import json
import os
import subprocess
import sys
import time

# Windows yabai reports but that are not really user windows to spread out.
IGNORED_APPS = {"Dock", "WindowManager", "Window Manager", "SystemUIServer",
                "Control Center", "Notification Center"}


def yabai(*args, check=True):
    """Run a yabai command, returning (exit_code, stdout, stderr)."""
    proc = subprocess.run(["yabai", "-m", *args],
                          capture_output=True, text=True)
    if check and proc.returncode != 0:
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def query(what, *extra):
    """yabai query returning parsed JSON, or None on failure."""
    code, out, _ = yabai("query", f"--{what}", *extra)
    if code != 0 or not out:
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return None


def window_space(wid):
    """Current space index of one window, or None if it is gone."""
    data = query("windows", "--window", str(wid))
    return data.get("space") if isinstance(data, dict) else None


def is_phantom(w):
    """
    A window yabai lists but no app is showing.

    2026-11-10: Signal and Bitwarden (Electron) keep a hidden window after
    close; yabai reports it with empty role and subrole, not visible, and
    System Events lists no window for the process. Real windows on other
    desktops are also not visible but carry role AXWindow.
    """
    return (not w.get("role") and not w.get("subrole")
            and not w.get("is-visible") and not w.get("has-ax-reference"))


def real_windows():
    """User windows worth placing, newest-space-first ordering left to caller."""
    wins = query("windows") or []
    keep = []
    for w in wins:
        if w.get("app") in IGNORED_APPS:
            continue
        if w.get("is-minimized"):
            continue          # minimized windows occupy no space visually
        if w.get("is-sticky"):
            continue          # sticky windows are on every space by design
        if is_phantom(w):
            continue          # hidden Electron window no app is showing
        keep.append(w)
    return keep


def pinned_spaces():
    """
    Spaces that hold a window we will not move but must not delete either.

    real_windows() drops minimized and sticky windows because neither should be
    redistributed. Deleting the space underneath them is a different question:
    macOS still keeps a minimized window on its space, so a space holding only a
    minimized window is NOT empty. Treating it as empty made asplode destroy a
    live desktop and dump the window onto space 1.
    """
    pinned = set()
    for w in query("windows") or []:
        if w.get("app") in IGNORED_APPS:
            continue
        if w.get("is-sticky"):
            continue          # genuinely on every space; pins nothing
        if w.get("is-minimized"):
            pinned.add(w["space"])
    return pinned


def dismiss_mission_control(verbose=False):
    """
    Press Escape to close Mission Control.

    There is no reliable way to ASK whether Mission Control is open: while it is
    up the Dock process reports zero UI groups, so its accessibility tree cannot
    be inspected. So do not try to detect it -- clear it when yabai says it is in
    the way, and let yabai's own error text be the source of truth.
    """
    subprocess.run(["osascript", "-e",
                    'tell application "System Events" to key code 53'],
                   capture_output=True, text=True)
    time.sleep(0.6)
    if verbose:
        print("  sent Escape to dismiss Mission Control")


def is_mission_control_error(err):
    """yabai refuses space edits while Mission Control is on screen."""
    low = (err or "").lower()
    return "mission-control" in low or "mission control" in low


def create_space(verbose=False):
    """
    Create a space and return (space_id, error), identifying it by ID.

    The obvious reading of `space --create` is that the new desktop is appended,
    so the newest one is last. It is not. Observed 2026-11-15 on a machine with
    eight desktops: the created space landed at index 4 of 9, ahead of five
    native-fullscreen desktops, not at index 9.

    That assumption was wrong in both places it was made, and it failed loudly
    in one and silently in the other:

      - The move loop sent windows to the last index, which was a fullscreen
        desktop, so every move died on "can not move window to a macOS
        fullscreen space!" and asplode reported "moved 0 of 2".

      - The scripting-addition probe DESTROYED the last index to clean up after
        itself, which is a different desktop than the one it made. It got away
        with it only because the last desktop happened to be fullscreen and
        yabai refused. With a normal desktop last, the probe destroys a desktop
        holding real windows.

    An ID is stable across the renumbering a create or destroy causes; an index
    is not. So the caller gets an ID back and re-resolves it to an index at the
    moment it is used.
    """
    before = {s["id"] for s in (query("spaces") or [])}
    code, _, err = yabai("space", "--create")
    if code != 0 and is_mission_control_error(err):
        # Mission Control can open mid-run (a probe, a stray hot corner).
        # Clear it and retry rather than abandoning the remaining work.
        dismiss_mission_control(verbose)
        before = {s["id"] for s in (query("spaces") or [])}
        code, _, err = yabai("space", "--create")
    if code != 0:
        return None, err or "space --create failed"

    new = [s["id"] for s in (query("spaces") or []) if s["id"] not in before]
    if len(new) == 1:
        return new[0], ""
    if not new:
        return None, "space --create reported success but no space appeared"
    # Another agent (a second asplode, Mission Control, the user) created a
    # space in the same instant. Guessing which one is ours risks destroying
    # or filling someone else's desktop, so refuse instead.
    return None, f"space --create raced: {len(new)} new spaces appeared"


def space_index(space_id):
    """Current index of a space ID, or None if it is gone."""
    for s in query("spaces") or []:
        if s["id"] == space_id:
            return s["index"]
    return None


def check_scripting_addition(verbose=False):
    """
    Verify yabai can actually create spaces.

    This used to create and destroy a probe space unconditionally. That was both
    destructive and self-defeating: the probe could leave Mission Control on
    screen, and the NEXT run would read yabai's "mission-control is active"
    refusal as a missing scripting addition and abort -- stranding every empty
    desktop it was supposed to close. Now a Mission Control refusal is treated as
    the transient it is: clear it and retry once.
    """
    probe_id, err = create_space(verbose)
    if probe_id is None:
        return False, err

    # Clean up the probe space BY ID. Re-resolve its index here rather than
    # reusing one read earlier: creating the probe renumbered the desktops.
    idx = space_index(probe_id)
    if idx is not None:
        yabai("space", str(idx), "--destroy")
    return True, "ok"


def plan(windows, spaces):
    """
    Work out which windows need to move.

    Each non-fullscreen space keeps exactly one of its current windows (the
    first); every other window is surplus and needs a space of its own. Keeping
    an incumbent avoids pointless churn: a space with one window already is
    already correct and nothing on it moves.
    """
    fullscreen_spaces = set()
    by_space = {}
    for w in windows:
        sp = w["space"]
        if w.get("is-native-fullscreen"):
            fullscreen_spaces.add(sp)
            continue
        by_space.setdefault(sp, []).append(w)

    stay, surplus = [], []
    for sp, wins in sorted(by_space.items()):
        stay.append((sp, wins[0]))
        surplus.extend(wins[1:])

    # Spaces with no movable window are landing pads for surplus windows.
    # A space holding a minimized window is not a landing pad: it is occupied by
    # something we chose not to move, and stacking onto it recreates the very
    # pile-up asplode exists to undo.
    occupied = {sp for sp, _ in stay} | fullscreen_spaces | pinned_spaces()
    vacant = [s["index"] for s in spaces
              if s["index"] not in occupied and not s.get("is-native-fullscreen")]

    return surplus, vacant, fullscreen_spaces


def move_window(wid, target, verbose=False):
    """
    Move one window to a space and confirm it landed.

    The confirmation is not paranoia: without the scripting addition yabai exits
    0 without moving anything, so an unverified move reports false success.
    """
    code, _, err = yabai("window", str(wid), "--space", str(target))
    if code != 0:
        return False, err
    time.sleep(0.12)          # the move is async; give the WM a beat to apply it
    landed = window_space(wid)
    if landed == target:
        return True, ""
    return False, f"did not land (still on space {landed})"


# Filled by destroy_empty_spaces so a caller (trim) can exit nonzero when the
# sweep failed; the return value stays the count of desktops removed.
LAST_DESTROY_FAILURES = []


def sa_failure_hint():
    """
    Say WHICH scripting-addition failure this is, rather than guessing.

    Two causes produce byte-identical symptoms, and the fix for one is useless
    against the other, so a fixed hint is wrong half the time:

      1. A Dock restart dropped the payload. yabai keeps running and never
         reloads it, so `--load-sa` fixes it instantly. Caught 2026-09-07, six
         failures from trim twelve minutes after a clean Dock restart.
      2. macOS outran the payload. The addition patches byte patterns per macOS
         POINT release, so a new one leaves `--load-sa` failing with no output
         and NOTHING local to fix. Caught 2026-09-06 on 26.6.2 and again
         2026-10-11 on 26.7, where the September hint told Chris to run
         `--load-sa` (exits 1 silently) and to register a signal that was
         already registered.

    The two are distinguishable: if `--load-sa` cannot reload it, the payload
    does not match this OS. Probe with the real command rather than inferring.
    """
    signal_live = False
    try:
        code, out, _ = yabai("signal", "--list")
        signal_live = code == 0 and "dock_did_restart" in out
    except Exception:
        pass

    # The decisive probe: a cause-1 outage reloads, a cause-2 outage cannot.
    reload_works = False
    try:
        proc = subprocess.run(["sudo", "-n", "yabai", "--load-sa"],
                              capture_output=True, text=True, timeout=15)
        reload_works = proc.returncode == 0
    except Exception:
        pass

    if reload_works:
        return ("  the scripting addition had been dropped and has just been\n"
                "  reloaded; rerun asplode and it should work.\n"
                "  It lives inside Dock.app and dies when Dock restarts."
                + ("" if signal_live else
                   "\n  ~/.yabairc has no dock_did_restart signal, so this will\n"
                   "  recur on the next Dock restart. Register it:\n"
                   "    yabai -m signal --add event=dock_did_restart \\\n"
                   "      action=\"sudo /opt/homebrew/bin/yabai --load-sa\""))

    build = ""
    try:
        build = subprocess.run(["sw_vers", "-productVersion"],
                               capture_output=True, text=True).stdout.strip()
    except Exception:
        pass
    return ("  the scripting addition cannot be loaded at all, and reloading it\n"
            "  just failed, so this is NOT a Dock restart and --load-sa will not\n"
            f"  help. macOS {build} has almost certainly outrun the payload, which\n"
            "  is built per macOS POINT release.\n"
            "  Check upstream before rebuilding: a fix may exist only on master,\n"
            "  or nowhere yet, in which case there is nothing local to do.")


ITERM_WINDOW_TTYS = '''
tell application "iTerm2"
  set output to ""
  repeat with w in windows
    repeat with t in tabs of w
      set s to current session of t
      set output to output & (id of w) & " " & (tty of s) & linefeed
    end repeat
  end repeat
  return output
end tell
'''


def claude_window_ids():
    """
    yabai window ids of the iTerm2 windows running Claude.

    The join is tty -> iTerm window id -> yabai window id, and every leg is
    exact rather than heuristic:

      - A process counts as Claude only when the BASENAME OF ITS EXECUTABLE is
        `claude`. Matching the word anywhere in the command line reports a
        `grep claude` as a session of its own; this is the same test `tc which`
        makes, for the same reason.
      - iTerm2's `id of window` IS the yabai window id. Verified 2026-11-15:
        all 14 ids matched exactly. Titles are NOT a usable key, because
        `Default (-tcsh)` appears on several windows at once.
      - A window counts as Claude if ANY of its tabs runs Claude. One iTerm
        window here holds three Claude tabs, and the desktop it sits on cannot
        be half-sorted.

    Returns `(ids, reason)`. An empty set makes the caller skip the sort rather
    than guess at an order, and `reason` says WHY it is empty, because the
    honest answers are not interchangeable:

      - `None`             windows were found; `ids` is real.
      - "none open"        the lookup worked and there are genuinely none.
      - anything else      the lookup FAILED and this is the error.

    Collapsing those into one empty set is a bug this function used to have.
    Every failure returned the same value as a successful empty answer, so
    asplode told Chris "no Claude windows found" while he was looking at
    eleven of them. The case that matters is macOS refusing the AppleScript:
    automation permission is granted per controlling app, and `killall Dock`,
    which this feature's `mru-spaces` change requires, is the class of event
    that can trigger a fresh prompt. A refusal is not an observation.
    """
    try:
        ps = subprocess.run(["/bin/ps", "-A", "-o", "tty=,pid=,command="],
                            capture_output=True, text=True, timeout=10)
    except Exception as exc:
        return set(), f"could not list processes: {exc}"
    if ps.returncode != 0:
        return set(), f"ps failed: {(ps.stderr or '').strip()}"

    claude_ttys = set()
    for line in ps.stdout.splitlines():
        fields = line.split()
        if len(fields) < 3 or fields[0] in ("??", "-"):
            continue          # no controlling terminal: not an iTerm tab
        if os.path.basename(fields[2]) == "claude":
            claude_ttys.add(fields[0])

    if not claude_ttys:
        return set(), "none open"

    try:
        proc = subprocess.run(["osascript", "-e", ITERM_WINDOW_TTYS],
                              capture_output=True, text=True, timeout=20)
    except subprocess.TimeoutExpired:
        return set(), "iTerm2 did not answer within 20s"
    except Exception as exc:
        return set(), f"could not ask iTerm2: {exc}"
    if proc.returncode != 0:
        # The usual cause is TCC: "Not authorized to send Apple events to
        # iTerm2" (-1743), fixed in System Settings > Privacy & Security >
        # Automation. Pass yabai's own words along rather than paraphrasing.
        return set(), f"iTerm2 refused the query: {(proc.stderr or '').strip()}"

    ids = set()
    for line in proc.stdout.splitlines():
        fields = line.split()
        if len(fields) != 2:
            continue
        wid, tty = fields[0], fields[1].replace("/dev/", "")
        if tty in claude_ttys and wid.isdigit():
            ids.add(int(wid))
    if not ids:
        # Claude processes exist but none of their ttys matched an iTerm tab,
        # so they are running somewhere else (tmux, ssh, Terminal.app).
        return set(), "Claude is running, but not in an iTerm2 tab"
    return ids, None


def warn_if_macos_will_resort():
    """
    Warn when macOS is set to rearrange desktops on its own.

    With "Automatically rearrange Spaces based on most recent use" ON
    (`com.apple.dock mru-spaces` = 1), macOS reorders desktops by recency, so
    any order this sort produces is undone the moment Chris switches desktops.
    The sort still exits 0 and still reports the moves it made, which makes the
    failure invisible: the tool says it worked and the desktops drift back.

    Checked here rather than only documented, because a docstring helps whoever
    reads the source and this helps whoever runs the tool and wonders why
    nothing stuck. The read is one `defaults` call and cannot fail destructively;
    an unreadable value is left alone rather than guessed at.
    """
    try:
        proc = subprocess.run(["defaults", "read", "com.apple.dock",
                               "mru-spaces"],
                              capture_output=True, text=True, timeout=10)
    except Exception:
        return            # cannot read it: say nothing rather than guess
    if proc.returncode != 0:
        # The key is absent until it is set once, and macOS treats absent as
        # ON. Worth saying, since that is the drift case, not the safe one.
        print("  note: com.apple.dock mru-spaces is unset, which macOS treats"
              " as ON, so it may undo this sort", file=sys.stderr)
        print("  turn it off with: defaults write com.apple.dock mru-spaces"
              " -bool false && killall Dock", file=sys.stderr)
        return
    if proc.stdout.strip() not in ("0", "false"):
        print("  warning: macOS is set to rearrange desktops by most recent"
              " use, so it will undo this sort", file=sys.stderr)
        print("  turn it off with: defaults write com.apple.dock mru-spaces"
              " -bool false && killall Dock", file=sys.stderr)


def claude_spaces(claude_ids):
    """Space indices holding at least one Claude window."""
    spaces = set()
    for w in query("windows") or []:
        if w["id"] in claude_ids:
            spaces.add(w["space"])
    return spaces


def sort_claude_left(dry_run, verbose):
    """
    Reorder desktops so Claude ones come first, stable within each group.

    `yabai -m space N --move M` moves space N to position M and shifts the rest
    along, so repeated insertion builds any permutation. Selection-sort style:
    walk the target order and pull each desktop forward to where it belongs,
    re-querying after every step because every move renumbers the ones it
    passed.

    Native-fullscreen desktops are sorted like any other. They were first
    treated as immovable walls, which was a GUESS and a wrong one: probed live
    2026-11-15, `space <fullscreen> --move 1` exits 0 and actually reorders,
    and a normal desktop moves across fullscreen ones freely. On this machine
    seven of twenty-six desktops are fullscreen and scattered from index 2
    onward, so the wall rule reduced the sortable range to one desktop and made
    the whole feature a no-op. A fullscreen desktop holding a Claude window
    sorts left with the rest.
    """
    warn_if_macos_will_resort()
    claude_ids, why = claude_window_ids()
    if not claude_ids:
        if why == "none open":
            print("  no Claude windows open; leaving desktop order alone")
        else:
            # A failed lookup is NOT the same as an empty one, so it goes to
            # stderr and says what actually happened. Reporting it as "none
            # open" would be a confidently wrong answer.
            print(f"  could not identify Claude windows: {why}",
                  file=sys.stderr)
            print("  leaving desktop order alone", file=sys.stderr)
        return 0

    sortable = query("spaces") or []
    if len(sortable) < 2:
        return 0

    on_claude = claude_spaces(claude_ids)
    current = [s["index"] for s in sortable]
    desired = ([i for i in current if i in on_claude]
               + [i for i in current if i not in on_claude])

    if current == desired:
        print(f"  desktop order already has Claude first "
              f"({len(on_claude & set(current))} Claude, "
              f"{len(current) - len(on_claude & set(current))} other)")
        return 0

    if dry_run:
        # A dry run has moved nothing and closed nothing, so these indices are
        # NOT the ones the real run will sort: the sweep renumbers everything
        # above each destroyed desktop. Report the plan by window label, which
        # survives renumbering, and say plainly that the numbers will differ.
        # (Printing stale indices as if they were the plan is the same bug
        # `planned` fixes in destroy_empty_spaces.)
        titles = {}
        for w in query("windows") or []:
            titles.setdefault(w["space"], f"{w['app']}: {w.get('title','')[:38]}")
        print("  would sort these to the left, in this order:")
        for idx in desired:
            if idx in on_claude:
                print(f"    {titles.get(idx, '(empty desktop)')}")
        print("  then everything else, in its present order")
        print("  (desktop numbers will differ: the sweep above renumbers them)")
        return len(desired)

    # `order` tracks where each original desktop currently sits. yabai renumbers
    # on every move, so the identity of a desktop is its POSITION in this list,
    # never the index it had when the plan was made.
    order = list(current)
    moves = 0
    for target_pos, original in enumerate(desired):
        here = order.index(original)
        if here == target_pos:
            continue
        # Positions are 1-based desktop indices for the sortable prefix, which
        # always starts at desktop 1.
        code, _, err = yabai("space", str(here + 1), "--move",
                             str(target_pos + 1))
        if code != 0 and is_mission_control_error(err):
            dismiss_mission_control(verbose)
            code, _, err = yabai("space", str(here + 1), "--move",
                                 str(target_pos + 1))
        if code != 0:
            print(f"  could not move desktop {here + 1} -> {target_pos + 1}:"
                  f" {err}", file=sys.stderr)
            return moves
        order.insert(target_pos, order.pop(here))
        moves += 1
        if verbose:
            print(f"  moved desktop {here + 1} -> {target_pos + 1}")

    return moves


def destroy_empty_spaces(dry_run, verbose, planned=()):
    """
    Remove spaces with no windows, highest index first.

    Descending order matters: destroying space 4 renumbers everything above it,
    so a low-to-high pass would delete the wrong desktops.

    `planned` holds spaces a dry run said it would move windows into. A real run
    does not need them: the moves have already happened, so those spaces are no
    longer empty when this re-queries. A dry run moved nothing, so without them
    it reads its own unchanged state and claims it would destroy the very spaces
    it just claimed to fill.
    """
    spaces = query("spaces") or []
    windows = real_windows()
    live = {w["space"] for w in windows} | set(planned) | pinned_spaces()

    empties = [s["index"] for s in spaces
               if s["index"] not in live
               and not s.get("is-native-fullscreen")]

    # macOS must keep at least one desktop.
    if len(empties) >= len(spaces):
        empties = empties[1:]

    if not empties:
        return 0

    removed = 0
    for idx in sorted(empties, reverse=True):
        if dry_run:
            print(f"  would destroy empty space {idx}")
            removed += 1
            continue
        code, _, err = yabai("space", str(idx), "--destroy")
        if code == 0:
            removed += 1
            if verbose:
                print(f"  destroyed empty space {idx}")
        else:
            print(f"  could not destroy space {idx}: {err}", file=sys.stderr)
            LAST_DESTROY_FAILURES.append((idx, err))
    if any("scripting-addition" in err for _, err in LAST_DESTROY_FAILURES):
        print(sa_failure_hint(), file=sys.stderr)
    return removed


def main():
    ap = argparse.ArgumentParser(
        description="Give every window its own desktop; close empty desktops.")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="print the plan without changing anything")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="show each move as it happens")
    ap.add_argument("--no-sort", action="store_true",
                    help="leave desktop order alone (skip Claude-left sorting)")
    args = ap.parse_args()

    if subprocess.run(["which", "yabai"], capture_output=True).returncode != 0:
        sys.exit("asplode: yabai is not installed (brew install koekeishiya/formulae/yabai)")

    spaces = query("spaces")
    if spaces is None:
        sys.exit("asplode: yabai is not running (yabai --start-service)")

    windows = real_windows()
    surplus, vacant, fs_spaces = plan(windows, spaces)

    print(f"asplode: {len(windows)} windows across {len(spaces)} spaces "
          f"({len(fs_spaces)} fullscreen, left alone)")

    if not surplus:
        print("  every window already has its own desktop")
    else:
        print(f"  {len(surplus)} window(s) need a desktop of their own")

    if not args.dry_run and surplus:
        ok, msg = check_scripting_addition(args.verbose)
        if not ok:
            # Redistribution needs the scripting addition, but closing empty
            # desktops does not. Bailing out entirely here was what left empty
            # desktops behind on every failed run, so skip the moves and still
            # run the sweep below.
            print("asplode: cannot redistribute windows "
                  f"({msg}).\n"
                  "  Spaces cannot be created and window moves fail silently.\n"
                  + sa_failure_hint() + "\n"
                  "  Continuing to close empty desktops anyway.",
                  file=sys.stderr)
            surplus = []

    moved = 0
    planned = []               # dry-run targets, so the sweep below spares them
    for w in surplus:
        label = f"{w['app']}: {w.get('title', '')[:40]}"
        if vacant:
            target = vacant.pop(0)
            action = f"space {target}"
        else:
            target = None
            action = "new space"

        if args.dry_run:
            if target is not None:
                planned.append(target)
            print(f"  would move [{label}] -> {action}")
            continue

        if target is None:
            new_id, err = create_space(args.verbose)
            if new_id is None:
                print(f"  could not create space: {err}", file=sys.stderr)
                break
            # Resolve the ID to an index now, right before the move: the create
            # renumbered every desktop after the insertion point.
            target = space_index(new_id)
            if target is None:
                print("  created space vanished before the move",
                      file=sys.stderr)
                break

        ok, err = move_window(w["id"], target, args.verbose)
        if ok:
            moved += 1
            if args.verbose:
                print(f"  moved [{label}] -> space {target}")
        else:
            print(f"  failed [{label}] -> space {target}: {err}", file=sys.stderr)

    if not args.dry_run and surplus:
        print(f"  moved {moved} of {len(surplus)} window(s)")

    print("closing empty desktops")
    removed = destroy_empty_spaces(args.dry_run, args.verbose, planned)
    verb = "would remove" if args.dry_run else "removed"
    print(f"  {verb} {removed} empty desktop(s)")

    # Sorting comes LAST because the sweep renumbers desktops: ordering them
    # before empties are closed would sort indices that are about to change.
    if not args.no_sort:
        print("sorting Claude desktops to the left")
        sort_claude_left(args.dry_run, args.verbose)

    if not args.dry_run:
        final = query("spaces") or []
        print(f"asplode: now {len(final)} desktop(s)")


if __name__ == "__main__":
    main()
