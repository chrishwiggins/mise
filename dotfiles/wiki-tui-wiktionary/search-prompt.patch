+/// Name the site being searched from the endpoint host, so a config pointing at
+/// en.wiktionary.org reads "Search Wiktionary" rather than "Search Wikipedia".
+fn empty_prompt(config: &Config) -> String {
+    let site = config
+        .api
+        .endpoint
+        .host_str()
+        .and_then(|host| host.split('.').rev().nth(1))
+        .map(|name| {
+            let mut chars = name.chars();
+            match chars.next() {
+                Some(first) => first.to_uppercase().chain(chars).collect(),
+                None => String::new(),
+            }
+        })
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| "Wikipedia".to_string());
+    format!("Search {}", site)
+}
